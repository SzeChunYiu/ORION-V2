  "principles": [
    "V1 and V2 receive the same public problem information, source corpus, provider/tool classes, authority permissions, random seed and held-out case identity",
    "per-case ceilings are frozen before either paired outcome is observed",
    "provider/tool failures and timeout/resource exhaustion remain execution outcomes and cannot be converted into scientific negatives",
    "V2 may not receive a larger search, model-call, compute, time or output budget merely because its architecture is more complex",
    "if an architecture cannot operate within the frozen matched budget, the result is an observed cost/overreach outcome rather than a post-hoc budget increase",
    "simple controls explicitly measure unnecessary work/escalation in addition to scientific terminal parity",
    "any unavoidable asymmetric capability is disclosed before run and forces CANNOT_CHECK_MATCHING_OR_CUSTODY unless an externally approved equivalence rule is frozen"
  ],
  "required_case_budget_coordinates": [
    "wall_clock_ceiling_seconds",
    "provider_call_ceiling_by_capability",
    "retrieval_query_ceiling",
    "retrieved_item_or_byte_ceiling",
    "local_process_timeout_ceiling_seconds",
    "local_process_output_ceiling_bytes",
    "max_solver_or_control_iterations",
    "retry_ceiling_by_failure_class",
    "context_or_input_byte_ceiling",
    "random_seed_or_determinism_binding",
    "network_access_policy",
    "side_effect_permission_policy"
  ],
  "campaign_specific_matching": [
