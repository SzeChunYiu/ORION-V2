{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion-v2.example/schemas/generalization-receipt-v0.json",
  "title": "ORION-V2 Conservative Domain Theory Generalization Receipt V0",
  "type": "object",
  "required": [
    "receipt_id",
    "native_theory_id",
    "generalized_theory_id",
    "context_id",
    "source_ids",
    "state_map_id",
    "action_map_id",
    "judgment_map_id",
    "registered_judgment_ids",
    "assumption_dispositions",
    "transition_result",
    "judgment_result",
    "resource_result",
    "authority_result",
    "status",
    "grants"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "native_theory_id": {"type": "string", "minLength": 1},
    "generalized_theory_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "state_map_id": {"type": "string", "minLength": 1},
    "action_map_id": {"type": "string", "minLength": 1},
    "judgment_map_id": {"type": "string", "minLength": 1},
    "registered_judgment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assumption_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "disposition"],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "disposition": {
            "enum": [
              "PRESERVED",
              "CALIBRATED",
              "RELAXED",
              "DROPPED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "transition_result": {
      "enum": ["PRESERVED", "DRIFT", "CANNOT_CHECK"]
    },
    "judgment_result": {
      "enum": [
        "EXACT",
        "DECISION_RELATIVE",
        "SOUND_OVER_APPROXIMATION",
        "DRIFT",
        "CANNOT_CHECK"
      ]
    },
    "resource_result": {
      "enum": [
        "EXACT",
        "CONSERVATIVE_BOUND",
        "UNDERSTATED",
        "NOT_APPLICABLE",
        "CANNOT_CHECK"
      ]
    },
    "authority_result": {
      "enum": ["NON_AMPLIFYING", "AMPLIFIED", "CANNOT_CHECK"]
    },
    "counterexample_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "epoch_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "EXACT_INTERPRETATION",
        "CONSERVATIVE_GENERALIZATION",
        "DECISION_RELATIVE_ADAPTATION",
        "SOUND_ABSTRACTION",
        "INVALID_TRANSITION_DRIFT",
        "INVALID_NATIVE_JUDGMENT_DRIFT",
        "INVALID_ASSUMPTION_ERASURE",
        "INVALID_RESOURCE_UNDERSTATEMENT",
        "INVALID_AUTHORITY_AMPLIFICATION",
        "CANNOT_CHECK"
      ]
    },
    "grants": {
      "type": "object",
      "required": [
        "scientific_truth",
        "novelty",
        "v2_admission",
        "adoption_authority"
      ],
      "properties": {
        "scientific_truth": {"const": false},
        "novelty": {"const": false},
        "v2_admission": {"const": false},
        "adoption_authority": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
