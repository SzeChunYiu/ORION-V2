      "second empirical science with materially different data_measurement semantics"
    ],
    "eligible_cases_minimum_per_domain": 30,
    "primary_endpoint": "registered scientific decision with domain-appropriate external witness"
  },
  "standalone_survival": {
    "R2_trigger": true,
    "phase_A_named_mechanism_causal_value": true,
    "phase_B_minimum_winning_domains": 2,
    "phase_B_minimum_gain_pp": 10,
    "paired_intervals_exclude_zero_after_Holm": true,
    "resource_matched_simple_does_not_reproduce_gain": true,
    "no_domain_critical_failure_increase": true,
    "at_least_one_domain_not_reproduced_by_language_scaffold": true,
    "independent_domain_adjudication_accepts_external_witness": true
  },
  "negative_control_required_each_phase": true,
  "contraction_terminals": [
    "NO_R2_EFFECT_TO_EXPLAIN__P_F_STANDALONE_ROUTE_CLOSED_OR_MERGE",
    "CANNOT_IDENTIFY_PREOUTCOME_MECHANISM",
