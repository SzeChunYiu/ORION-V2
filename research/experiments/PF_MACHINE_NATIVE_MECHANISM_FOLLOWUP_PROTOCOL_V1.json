      "M0_SIMPLE_DIRECT",
      "M1_FULL_NATIVE",
      "M2_MINUS_PRIMARY_MECHANISM",
      "M3_RESOURCE_MATCHED_SIMPLE",
      "M4_HUMAN_MIMETIC_SCAFFOLD_MATCH"
